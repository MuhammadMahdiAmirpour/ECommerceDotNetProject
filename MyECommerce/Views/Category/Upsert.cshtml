@model ModelClasses.Category

<div class="PaddingAll">
    <h2 class="text-info text-center mb-4">@((Model.Id == 0) ? "Create Category" : "Edit Category")</h2>
    <hr/>

    <div class="PaddingAllWhite">
        <form asp-action="Upsert" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Enter category name" required/>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <input type="hidden" asp-for="Id"/>

            <div class="form-group text-center">
                <input type="submit" value="Save" class="btn btn-primary btn-lg mr-2"/>
                <a asp-action="Index" class="btn btn-secondary btn-lg">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}