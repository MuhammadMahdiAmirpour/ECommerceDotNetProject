@model ModelClasses.Category

<div class="PaddingAll">
    <div class="PaddingAllWhite">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-danger mb-4">Delete Category</h2>
            </div>
        </div>

        <div class="row">
            <div class="col-12 text-center">
                <h4 class="mb-4">Are you sure you want to delete this category?</h4>
            </div>
        </div>

        <div class="row">
            <div class="col-12 text-center">
                <h5 class="mb-4">@Model.Name</h5>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id"/>

            <div class="row">
                <div class="col-12 text-center">
                    <div class="form-group">
                        <input type="submit" value="Delete" class="btn btn-danger mr-2"/>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>